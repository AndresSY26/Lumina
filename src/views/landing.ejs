<!DOCTYPE html>
<html lang="es">
<%- include('layout') %>
<body class="landing-body">
    <div class="stars-bg"></div>
    <div class="landing-container">
        <!-- Hero Section -->
        <section class="hero-section">
            <div class="hero-content text-center">
                <div class="logo-container animate-float">
                    <i class="ph-duotone ph-planet text-primary text-6xl"></i>
                </div>
                <h1 class="orbitron text-xxl text-white mt-4 tracking-widest glow-text">
                    LUMINA
                </h1>
                <p class="text-primary font-mono tracking-wider text-base mt-2 mb-8 uppercase">
                    Inteligencia Lunar Táctica
                </p>
                
                <a href="/auth" class="btn-primary-lg orbitron">
                    ACCEDER AL SISTEMA
                </a>
            </div>
        </section>

        <!-- Features Grid -->
        <section class="features-section mt-12">
            <div class="feature-card glass-panel">
                <i class="ph-duotone ph-compass text-accent text-4xl mb-2"></i>
                <h3 class="orbitron text-white text-lg">Rastreo Preciso</h3>
                <p class="text-silver text-sm">Guía azimutal en tiempo real para navegación celeste.</p>
            </div>
            
            <div class="feature-card glass-panel">
                <i class="ph-duotone ph-camera text-primary text-4xl mb-2"></i>
                <h3 class="orbitron text-white text-lg">Visión AR</h3>
                <p class="text-silver text-sm">HUD de realidad aumentada sobre el entorno físico.</p>
            </div>

            <div class="feature-card glass-panel">
                <i class="ph-duotone ph-chart-line-up text-gold text-4xl mb-2"></i>
                <h3 class="orbitron text-white text-lg">Telemetría</h3>
                <p class="text-silver text-sm">Predicción avanzada de fases y visibilidad lunar.</p>
            </div>
        </section>

        <!-- Footer -->
        <footer class="mt-auto py-6 text-center">
            <p class="text-xs text-silver font-mono opacity-50">
                SYSTEM V1.0 // SENSORS CALIBRATION REQUIRED
            </p>
        </footer>
    </div>
</body>
</html>
