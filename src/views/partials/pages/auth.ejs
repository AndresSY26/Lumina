<section id="page-auth" class="page-section hidden center-content bg-space-deep">
    <div class="glass-panel p-8 w-full max-w-sm mx-4">
        <div class="text-center mb-6">
            <i class="ph-duotone ph-fingerprint text-4xl text-primary mb-2"></i>
            <h2 class="orbitron text-xl text-white">IDENTIFICACIÓN</h2>
        </div>

        <form id="auth-form" class="space-y-4">
            <div class="input-group">
                <input type="text" placeholder="ID DE OPERADOR" class="input-neon w-full" value="CMDR-001" readonly />
            </div>
            
            <div class="input-group">
                <input type="password" placeholder="CÓDIGO DE ACCESO" class="input-neon w-full" value="******" readonly />
            </div>

            <button type="submit" class="btn-primary w-full mt-4">
                <span class="mr-2">AUTORIZAR</span>
                <i class="ph-bold ph-arrow-right"></i>
            </button>
        </form>
    </div>
</section>
