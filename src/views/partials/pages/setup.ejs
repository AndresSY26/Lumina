<section id="page-setup" class="page-section hidden center-content relative">
    <div class="absolute inset-0 z-0 bg-space-deep"></div>

    <div class="setup-guide text-center max-w-md px-6 relative z-10">
        <!-- Animated Icon -->
        <div class="relative w-32 h-32 mx-auto mb-8 flex items-center justify-center">
            <div class="absolute inset-0 border border-gold/30 rounded-full animate-spin-slow-reverse"></div>
            <div class="absolute inset-2 border border-dashed border-gold/20 rounded-full animate-spin-slow"></div>
            <i class="ph-duotone ph-compass text-6xl text-gold animate-pulse-slow relative z-10 drop-shadow-[0_0_15px_rgba(255,215,0,0.5)]"></i>
        </div>
        
        <h2 class="orbitron text-2xl text-white mb-2 tracking-widest">CALIBRACIÓN</h2>
        <p class="text-gold/60 font-mono text-xs tracking-widest mb-8">INICIALIZANDO SISTEMAS DE NAVEGACIÓN</p>
        
        <p class="text-gray-400 mb-8 leading-relaxed text-sm">
            Lumina requiere acceso a los sensores de orientación y ubicación de su dispositivo para calcular trayectorias celestiales con precisión absoluta.
        </p>

        <!-- Checklist -->
        <div class="permissions-list text-left bg-black/40 border border-white/10 p-6 rounded-xl mb-8 backdrop-blur-sm">
            <div class="perm-item flex items-center mb-4 last:mb-0">
                <div class="w-8 h-8 rounded bg-emerald-500/10 flex items-center justify-center mr-4 border border-emerald-500/20">
                    <i class="ph-fill ph-check text-emerald-500"></i>
                </div>
                <div>
                    <h4 class="text-white text-sm font-bold orbitron">GIROSCOPIO</h4>
                    <span class="text-gray-500 text-xs">Orientación 3DoF</span>
                </div>
            </div>
            <div class="perm-item flex items-center">
                <div class="w-8 h-8 rounded bg-emerald-500/10 flex items-center justify-center mr-4 border border-emerald-500/20">
                    <i class="ph-fill ph-check text-emerald-500"></i>
                </div>
                <div>
                     <h4 class="text-white text-sm font-bold orbitron">GEOLOCALIZACIÓN</h4>
                     <span class="text-gray-500 text-xs">Latitud / Longitud</span>
                </div>
            </div>
        </div>

        <button id="btn-grant-perms" class="btn-cta w-full group">
            <span class="relative z-10 flex items-center justify-center gap-3 text-sm">
                <i class="ph-bold ph-crosshair text-xl group-hover:rotate-90 transition-transform duration-500"></i> ACTIVAR SENSORES
            </span>
        </button>
    </div>
</section>
