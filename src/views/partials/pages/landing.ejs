<section id="page-landing" class="page-section active center-content overflow-hidden relative">
    
    <!-- 0. ATMOSPHERE BACKGROUND -->
    <div class="absolute inset-0 z-0">
        <div class="stars-layer-1"></div>
        <div class="stars-layer-2"></div>
        <div class="nebula-glow"></div>
    </div>

    <!-- Main Content Container -->
    <div class="landing-container w-full max-w-5xl mx-auto px-6 py-12 flex flex-col items-center relative z-10">
        
        <!-- 1. HERO SECTION -->
        <div class="hero-section text-center mb-16">
            
            <!-- HOLOGRAPHIC ORB (3D CANVAS) -->
            <!-- HOLOGRAPHIC ORB (3D CANVAS) -->
            <div id="landing-moon-container" class="mb-10 relative">
                <!-- FALLBACK IMAGE (Round & Centered) -->
                <img src="https://raw.githubusercontent.com/mrdoob/three.js/master/examples/textures/planets/moon_1024.jpg" 
                     style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); width: 80%; height: 80%; border-radius: 50%; object-fit: cover; z-index: -10; opacity: 0.8;"
                     alt="Moon Fallback">
                     
                <!-- 3D Canvas will be injected here by main.js -->
                 
                <!-- Core Glow Behind -->
                <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-3/4 h-3/4 bg-cyan-500/10 blur-3xl rounded-full pointer-events-none -z-20"></div>
            </div>

            <!-- GLITCH TITLE -->
            <h1 class="orbitron text-hero font-black text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 via-white to-purple-500 mb-4 tracking-widest leading-none drop-shadow-neon" data-value="LUMINA">
                LUMINA
            </h1>
            
            <p class="text-blue-100 text-lg md:text-xl font-light tracking-[0.2em] mb-12 max-w-2xl mx-auto opacity-80 uppercase">
                Inteligencia Lunar de Grado Táctico
            </p>

            <!-- PULSING CTA -->
            <button id="btn-enter" class="btn-detonator group relative">
                <span class="relative z-10 flex items-center justify-center gap-3 orbitron font-bold tracking-[0.2em]">
                    <i class="ph-fill ph-power text-xl"></i> INICIAR SISTEMA
                </span>
                <div class="absolute inset-0 border border-cyan-400/50 rounded-sm"></div>
                <div class="absolute inset-0 bg-cyan-500/10 opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
                <div class="scanline"></div>
            </button>
        </div>

        <!-- 2. HOLOGRAPHIC CARDS -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 w-full mb-12">
            <!-- Card 1 -->
            <div class="holo-card group">
                <div class="holo-content text-center p-6">
                    <i class="ph-duotone ph-compass text-cyan-400 text-4xl mb-4 group-hover:scale-110 transition-transform"></i>
                    <h3 class="orbitron text-white text-lg mb-2 tracking-wider">PRECISIÓN</h3>
                    <p class="text-blue-200/70 text-xs font-mono">Giroscopio Táctico Calibrado</p>
                </div>
                <div class="holo-border"></div>
            </div>

            <!-- Card 2 -->
            <div class="holo-card group">
                <div class="holo-content text-center p-6">
                    <i class="ph-duotone ph-crosshair text-purple-400 text-4xl mb-4 group-hover:scale-110 transition-transform"></i>
                    <h3 class="orbitron text-white text-lg mb-2 tracking-wider">RASTREO AR</h3>
                    <p class="text-blue-200/70 text-xs font-mono">Visualización de Objetivo HUD</p>
                </div>
                <div class="holo-border"></div>
            </div>

            <!-- Card 3 -->
            <div class="holo-card group">
                <div class="holo-content text-center p-6">
                    <i class="ph-duotone ph-shield-check text-emerald-400 text-4xl mb-4 group-hover:scale-110 transition-transform"></i>
                    <h3 class="orbitron text-white text-lg mb-2 tracking-wider">OFFLINE</h3>
                    <p class="text-blue-200/70 text-xs font-mono">Arquitectura Autónoma PWA</p>
                </div>
                <div class="holo-border"></div>
            </div>
        </div>

        <!-- 3. TERMINAL STATUS -->
        <div class="w-full border-t border-white/5 pt-6 flex justify-center gap-8 text-xxs font-mono text-cyan-500/60 uppercase tracking-widest">
            <span class="animate-pulse">SYS: ONLINE</span>
            <span>NET: SECURE</span>
            <span>VER: 3.0.0</span>
        </div>

    </div>

    <!-- TEXT DECODE SCRIPT -->
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const letters = "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789";
            const header = document.querySelector("#page-landing h1");
            
            if(header) {
                let iterations = 0;
                const interval = setInterval(() => {
                    header.innerText = header.innerText.split("")
                        .map((letter, index) => {
                            if(index < iterations) {
                                return header.dataset.value[index];
                            }
                            return letters[Math.floor(Math.random() * 26)];
                        })
                        .join("");
                    
                    if(iterations >= header.dataset.value.length) { 
                        clearInterval(interval);
                    }
                    
                    iterations += 1/3;
                }, 30);
            }
        });
    </script>
</section>
