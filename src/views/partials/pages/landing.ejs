    <!-- TEXT DECODE SCRIPT (Restored/Refined) -->
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            // Text Decode Effect
            const letters = "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789";
            const header = document.querySelector("#hero-moon-canvas + div h1"); // Target the new H1
            
            if(header) {
                let iterations = 0;
                // Store original text
                const originalText = header.innerText;
                const dataValue = header.dataset.value || originalText;
                
                const interval = setInterval(() => {
                    header.innerText = dataValue.split("")
                        .map((letter, index) => {
                            if(index < iterations) {
                                return dataValue[index];
                            }
                            return letters[Math.floor(Math.random() * 26)];
                        })
                        .join("");
                    
                    if(iterations >= dataValue.length) { 
                        clearInterval(interval);
                    }
                    
                    iterations += 1/2; // Slow down slightly
                }, 40);
            }
        });
    </script>
