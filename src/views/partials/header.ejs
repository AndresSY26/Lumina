            <span class="relative flex" style="width:8px; height:8px;">
                <span class="absolute inline-flex h-full w-full rounded-full bg-green-400 opacity-75 status-pulse" style="background:var(--c-success)"></span>
                <span class="relative inline-flex rounded-full h-2 w-2 status-dot"></span>
            </span>
            <span id="user-tier" class="text-xs font-mono font-bold text-success tracking-widest">ONLINE</span>
        </div>
        <div class="text-xs font-mono text-gray-400 flex items-center gap-2" id="gps-coords">
            <i class="ph-bold ph-crosshair-simple"></i> GPS: BUSCANDO...
        </div>
    </div>

    <div class="header-interactive text-right">
