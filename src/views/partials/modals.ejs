<!-- Permission Modal -->
<div id="modal-permissions" class="modal-overlay">
    <div class="modal-box">
        <i class="ph-duotone ph-lock-key-open text-primary text-4xl mb-4"></i>
        <h2>ACCESO SENSORES</h2>
        <p>Lumina requiere acceso al giroscopio y ubicación para funcionar.</p>
        <button id="btn-grant-perms" class="btn-primary full-width">
            CONCEDER ACCESO
        </button>
    </div>
</div>

<!-- Paywall Modal -->
<div id="modal-paywall" class="modal-overlay hidden">
    <div class="modal-box glass-gold">
        <i class="ph-duotone ph-crown text-gold text-4xl mb-4"></i>
        <h2 class="text-gold">LUMINA PRO</h2>
        <p>Desbloquea simulaciones futuras y modo telescopio AR.</p>
        <button class="btn-gold full-width">
            ACTUALIZAR ($4.99)
        </button>
        <button class="btn-text mt-2" id="btn-close-paywall">CANCELAR</button>
    </div>
</div>
