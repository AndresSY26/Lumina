<div class="dashboard-grid">
    <!-- Row 1: Moon Data -->
    <!-- Row 1: Moon Data -->
    <div class="data-card moon-card relative overflow-hidden">
        <!-- 3D MOON CONTAINER (Absolute Background or Header replacement) -->
        <div id="moon-3d-container" class="moon-3d-visual"></div>
        
        <div class="card-header text-accent z-10 relative">
             LUNA LIVE
        </div>
        <div class="card-body z-10 relative bg-black/20 backdrop-blur-sm rounded-lg p-2 mt-20">
            <div class="data-row">
                <span>FASE</span>
                <span class="data-value" id="moon-phase">--</span>
            </div>
            <div class="data-row">
                <span>ILUM</span>
                <span class="data-value" id="moon-illum">--%</span>
            </div>
        </div>
    </div>

    <!-- Row 2: Sun Data -->
    <div class="data-card">
        <div class="card-header text-warn">
            <i class="ph-bold ph-sun"></i> SOL
        </div>
        <div class="card-body">
            <div class="data-row">
                <span>ALBA</span>
                <span class="data-value" id="sun-rise">--:--</span>
            </div>
            <div class="data-row">
                <span>OCASO</span>
                <span class="data-value" id="sun-set">--:--</span>
            </div>
        </div>
    </div>

    <!-- Row 3: Trajectory (Full Width) -->
    <div class="data-card full-width graph-card">
        <canvas id="trajectory-canvas"></canvas>
        <div class="graph-label">TRAYECTORIA ELEVACIÓN</div>
    </div>
</div>
