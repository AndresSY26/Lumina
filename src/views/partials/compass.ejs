<div class="compass-module">
    <!-- Target Toggles -->
    <div class="target-controls">
        <button id="btn-target-toggle" class="btn-pill-toggle mode-moon">
            <i class="ph-fill ph-moon-stars icon-mode"></i>
            <span class="text-mode">LUNA</span>
        </button>
    </div>

    <div class="compass-container">
        <!-- Fixed Heading Indicator (Forward) -->
        <div class="heading-indicator"></div>

        <!-- Decor Rings -->
        <div class="ring-decor-outer"></div>
        <div class="ring-decor-dashed anim-spin-slow"></div>
        
        <!-- Rotating Assembly -->
        <div class="compass-lens" id="compass-ring">
            <div class="north-marker">N</div>
            <div class="cardinal-points">
                <span class="cardinal e">E</span>
                <span class="cardinal s">S</span>
                <span class="cardinal w">W</span>
            </div>
            
            <!-- Target Objects -->
            <div id="target-moon" class="celestial-pointer">
                <i class="ph-fill ph-moon-stars"></i>
            </div>
             <div id="target-sun" class="celestial-pointer sun">
                <i class="ph-fill ph-sun"></i>
            </div>
        </div>

        <!-- Static Overlay -->
        <div class="reticle-overlay">
            <div class="crosshair"></div>
            
            <!-- Guidance System -->
            <div class="guidance-overlay">
                <div class="guide-arrow left" id="arrow-left"><i class="ph-bold ph-caret-double-left"></i></div>
                <div class="readout-heading font-mono" id="heading-val">000°</div>
                <div class="guide-hint font-mono" id="guide-msg">BUSCANDO...</div>
                <div class="guide-arrow right" id="arrow-right"><i class="ph-bold ph-caret-double-right"></i></div>
            </div>
        </div>
    </div>
</div>
