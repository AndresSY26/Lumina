<div class="compass-module">
    <div class="compass-container">
        <!-- Decor Rings -->
        <div class="ring-decor-outer"></div>
        <div class="ring-decor-dashed anim-spin-slow"></div>
        
        <!-- Rotating Assembly -->
        <div class="compass-lens" id="compass-ring">
            <div class="north-marker">N</div>
            <div class="cardinal-points">
                <span class="cardinal e">E</span>
                <span class="cardinal s">S</span>
                <span class="cardinal w">W</span>
            </div>
            
            <!-- Target Objects -->
            <div id="target-moon" class="celestial-pointer">
                <i class="ph-fill ph-moon-stars"></i>
            </div>
             <div id="target-sun" class="celestial-pointer sun">
                <i class="ph-fill ph-sun"></i>
            </div>
        </div>

        <!-- Static Overlay -->
        <div class="reticle-overlay">
            <div class="crosshair"></div>
            <div class="readout-heading font-mono" id="heading-val">000°</div>
        </div>
    </div>
</div>
