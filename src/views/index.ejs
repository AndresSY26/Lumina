<!DOCTYPE html>
<html lang="es">
<%- include('layout') %>
<body>
    <div class="app-container">
        <!-- Background FX -->
        <div class="bg-stars"></div>
        <div class="bg-grid"></div>

        <!-- Header -->
        <%- include('partials/header') %>

        <!-- MAIN VIEWS (SPA Container) -->
        <main id="main-content">
            
            <!-- VIEW: HOME (Compass & Dashboard) -->
            <section id="view-home" class="view-panel active">
                <div class="scroll-content">
                    <%- include('partials/compass') %>
                    <%- include('partials/dashboard') %>
                    <div class="spacer-bottom"></div>
                </div>
            </section>

            <!-- VIEW: AR (Camera) -->
            <section id="view-ar" class="view-panel hidden">
                <div class="ar-container">
                    <video id="camera-feed" autoplay playsinline muted></video>
                    <div class="ar-overlay">
                        <div class="ar-reticle"></div>
                        <div class="ar-status">BÚSQUEDA VISUAL ACTIVA</div>
                    </div>
                </div>
            </section>

             <!-- VIEW: MAP (Placeholder) -->
             <section id="view-map" class="view-panel hidden">
                <div class="center-message">
                    <i class="ph-duotone ph-map-trifold text-4xl text-gray"></i>
                    <p>SISTEMA DE MAPADO OFFLINE</p>
                </div>
            </section>

        </main>

        <!-- Navigation -->
        <%- include('partials/navigation') %>

        <!-- Modals -->
        <%- include('partials/modals') %>
    </div>

    <!-- Client Logic (ES Modules) -->
    <script type="module" src="/js/main.js"></script>
</body>
</html>
