<!DOCTYPE html>
<html lang="es">
<%- include('layout') %>
<body class="auth-body flex justify-center items-center h-screen bg-void">
    <div class="stars-bg"></div>
    
    <div class="auth-card glass-panel p-8 rounded-2xl w-full max-w-md relative overflow-hidden">
        <!-- Decorator Line -->
        <div class="absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-transparent via-primary to-transparent"></div>

        <div class="text-center mb-8">
            <i class="ph-duotone ph-fingerprint text-primary text-5xl mb-4"></i>
            <h2 class="orbitron text-xl text-white tracking-wider">IDENTIFICACIÓN</h2>
            <p class="text-silver text-sm font-mono mt-2">Credenciales de Acceso Requeridas</p>
        </div>

        <form action="/setup" class="flex flex-col gap-6">
            <div class="input-group">
                <label class="text-xs text-primary font-mono mb-1 block">ID DE USUARIO</label>
                <div class="relative">
                    <i class="ph-duotone ph-user absolute left-3 top-1/2 -translate-y-1/2 text-silver"></i>
                    <input type="email" placeholder="operador@lumina.sys" class="input-terminal w-full pl-10 pr-4 py-3 bg-surface border border-white/10 rounded focus:border-primary text-white font-mono outline-none transition-colors" required>
                </div>
            </div>

            <div class="input-group">
                <label class="text-xs text-primary font-mono mb-1 block">CÓDIGO DE ACCESO</label>
                <div class="relative">
                    <i class="ph-duotone ph-key absolute left-3 top-1/2 -translate-y-1/2 text-silver"></i>
                    <input type="password" placeholder="••••••••" class="input-terminal w-full pl-10 pr-4 py-3 bg-surface border border-white/10 rounded focus:border-primary text-white font-mono outline-none transition-colors" required>
                </div>
            </div>

            <button type="submit" class="btn-primary mt-4 w-full flex justify-center items-center gap-2">
                <span>INICIAR SESIÓN</span>
                <i class="ph-bold ph-caret-right"></i>
            </button>
        </form>

        <div class="mt-6 text-center">
            <a href="#" class="text-xs text-silver hover:text-primary transition-colors">¿Solicitar acceso?</a>
        </div>
    </div>
</body>
</html>
