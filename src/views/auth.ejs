<!DOCTYPE html>
<html lang="es">
<%- include('layout') %>
<body class="auth-container">
    <div class="auth-bg-grid"></div>
    
    <div class="auth-card">
        <div class="auth-header">
            <i class="ph-duotone ph-fingerprint auth-icon"></i>
            <h2 class="auth-title">IDENTIFICACIÓN</h2>
            <p class="auth-subtitle">ACCESO RESTRINGIDO // NIVEL 5</p>
        </div>

        <form action="/setup" class="auth-form">
            <div class="auth-input-wrapper">
                <label class="auth-label">[ ID OPERADOR ]</label>
                <input type="text" placeholder="CMDR-001" class="auth-input" required>
            </div>

            <div class="auth-input-wrapper">
                <label class="auth-label">[ CLAVE DE SEGURIDAD ]</label>
                <input type="password" placeholder="••••••" class="auth-input" required>
            </div>

            <button type="submit" class="btn-auth">
                AUTORIZAR <i class="ph-bold ph-arrow-right"></i>
            </button>
        </form>
    </div>
</body>
</html>
